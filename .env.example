# Copy this file to .env for local development. Never commit .env.
# In production these are set in Hostinger: hPanel > Websites > cuubeauty.com > Node.js > Environment variables.

# Server port (server.js)
PORT=3000

# Calendar access goes through n8n (workflows "CUU Beauty disponibilidad (web)" and
# "CUU Beauty reservar (web)"), which use n8n's own Google Calendar connection.
# N8N_BOOKING_KEY must match the KEY constant in the "Validar" node of the reservar workflow.
N8N_BOOKING_KEY=change-me
# Optional, defaults to https://n8n.cuustudio.com/webhook
N8N_BASE_URL=https://n8n.cuustudio.com/webhook
