# Variables de entorno opcionales (en Hostinger: panel de la app Node.js > Variables de entorno).
# Nunca subas un archivo .env con valores reales al repositorio.

PORT=3000

# Webhook de n8n que registra la cita (crea el evento en Google Calendar y manda confirmaciones).
BOOKING_WEBHOOK_URL=https://n8n.cuustudio.com/webhook/book-appointment

# Webhook de n8n que devuelve los eventos del calendario de una especialista para un día.
AVAILABILITY_WEBHOOK_URL=https://n8n.cuustudio.com/webhook/cuu-beauty-disponibilidad

# Alternativa: leer los calendarios directo con una cuenta de servicio de Google (solo lectura).
# Si estas dos existen, tienen prioridad sobre AVAILABILITY_WEBHOOK_URL.
# GOOGLE_CLIENT_EMAIL=cuenta@proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
