# Copy this file to .env and fill in real values. Never commit .env.

# Server port (server.js)
PORT=3000

# Google service account used by server.js to create/read Google Calendar events.
# From Google Cloud Console > IAM & Admin > Service Accounts > (account) > Keys > Add key.
GOOGLE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key on one line with \n instead of real line breaks.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Hostinger FTP credentials, used by upload_ftp.py / upload_nodejs.py (local deploy scripts only).
CUU_FTP_HOST=195.35.38.244
CUU_FTP_USER=your_ftp_user
CUU_FTP_PASS=your_ftp_password
