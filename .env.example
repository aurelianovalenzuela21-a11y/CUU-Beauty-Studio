# Copy this file to .env for local development. Never commit .env.
# In production these are set in Hostinger: hPanel > Websites > cuubeauty.com > Node.js > Environment variables.

# Server port (server.js)
PORT=3000

# Google service account used by server.js to read/create Google Calendar events.
# Google Cloud Console > IAM & Admin > Service Accounts > (account) > Keys > Add key (JSON).
# Each staff calendar must be shared with this service account email ("Make changes to events").
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key on one line with \n instead of real line breaks.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Optional: n8n webhook that sends email/WhatsApp confirmations after a booking is saved.
N8N_WEBHOOK_URL=https://n8n.cuustudio.com/webhook/book-appointment
